Header>\n      <SidebarContent>\n        <NavMain items={data.navMain} />\n        <NavProjects projects={data.projects} />\n        <NavSecondary items={data.navSecondary} className=\"mt-auto\" />\n      </SidebarContent>\n      <SidebarFooter>\n        <NavUser user={data.user} />\n      </SidebarFooter>\n    </Sidebar>\n  )\n}\n","types":"import * as React from \"react\";\nimport { Sidebar } from \"../../../ui/sidebar.js\";\nexport declare function AppSidebar({ ...props }: React.ComponentProps<typeof Sidebar>): any;\n","variants":{},"repository":"https://github.com/shadcn-ui/ui","path":"apps/v4/registry/bases/base/blocks/sidebar-08/components/app-sidebar.tsx","url":"https://github.com/shadcn-ui/ui/blob/HEAD/apps/v4/registry/bases/base/blocks/sidebar-08/components/app-sidebar.tsx"}