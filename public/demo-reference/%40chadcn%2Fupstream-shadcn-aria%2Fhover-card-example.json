{"code":"\"use client\"\n\nimport {\n  Example,\n  ExampleWrapper,\n} from \"@/registry/bases/aria/components/example\"\nimport { Button } from \"@/registry/bases/aria/ui/button\"\nimport {\n  Dialog,\n  DialogDescription,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@/registry/bases/aria/ui/dialog\"\nimport {\n  HoverCard,\n  HoverCardTrigger,\n} from \"@/registry/bases/aria/ui/hover-card\"\n\nexport default function HoverCardExample() {\n  return (\n    <ExampleWrapper>\n      <HoverCardSides />\n      <HoverCardInDialog />\n    </ExampleWrapper>\n  )\n}\n\nconst HOVER_CARD_PLACEMENTS = [\n  \"start\",\n  \"left\",\n  \"top\",\n  \"bottom\",\n  \"right\",\n  \"end\",\n] as const\n\nfunction HoverCardSides() {\n  return (\n    <Example title=\"Sides\" containerClassName=\"col-span-2\">\n      <div className=\"flex flex-wrap items-center justify-center gap-2\">\n        {HOVER_CARD_PLACEMENTS.map((placement) => (\n          <HoverCardTrigger key={placement} delay={100} closeDelay={100}>\n            <Button variant=\"outline\" className=\"capitalize\">\n              {placement}\n            </Button>\n            <HoverCard placement={placement}>\n              <div className=\"flex flex-col style-vega:gap-2 style-nova:gap-1.5 style-lyra:gap-1 style-maia:gap-2 style-mira:gap-1 style-luma:gap-2\">\n                <h4 className=\"font-medium\">Hover Card</h4>\n                <p>\n                  This hover card appears on the {placement} side of the\n                  trigger.\n                </p>\n              </div>\n            </HoverCard>\n          </HoverCardTrigger>\n        ))}\n      </div>\n    </Example>\n  )\n}\n\nfunction HoverCardInDialog() {\n  return (\n    <Example title=\"In Dialog\">\n      <DialogTrigger>\n        <Button variant=\"outline\">Open Dialog</Button>\n        <Dialog>\n          <DialogHeader>\n            <DialogTitle>Hover Card Example</DialogTitle>\n            <DialogDescription>\n              Hover over the button below to see the hover card.\n            </DialogDescription>\n          </DialogHeader>\n          <HoverCardTrigger delay={100} closeDelay={100}>\n            <Button variant=\"outline\" className=\"w-fit\">\n              Hover me\n            </Button>\n            <HoverCard>\n              <div className=\"flex flex-col style-vega:gap-2 style-nova:gap-1.5 style-lyra:gap-1 style-maia:gap-2 style-mira:gap-1 style-luma:gap-2\">\n                <h4 className=\"font-medium\">Hover Card</h4>\n                <p>\n                  This hover card appears inside a dialog. Hover over the button\n                  to see it.\n                </p>\n              </div>\n            </HoverCard>\n          </HoverCardTrigger>\n        </Dialog>\n      </DialogTrigger>\n    </Example>\n  )\n}\n","types":"export default function HoverCardExample(): any;\n","variants":{},"repository":"https://github.com/shadcn-ui/ui","path":"apps/v4/registry/bases/aria/examples/hover-card-example.tsx","url":"https://github.com/shadcn-ui/ui/blob/HEAD/apps/v4/registry/bases/aria/examples/hover-card-example.tsx"}